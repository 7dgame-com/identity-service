{
  "name": "@7dgame/identity-service",
  "version": "0.1.0",
  "description": "XR UGC identity service with readonly legacy adapter for staged migration.",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch apps/identity-adapter/src/main.ts",
    "start": "node dist/apps/identity-adapter/src/main.js",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "iam:reconciliation:smoke": "tsx scripts/iam-reconciliation-smoke.ts",
    "iam:reconciliation:smoke:dist": "node dist/scripts/iam-reconciliation-smoke.js",
    "iam:organization-write:public-gate": "tsx scripts/iam-organization-write-public-gate.ts",
    "iam:organization-write:public-gate:dist": "node dist/scripts/iam-organization-write-public-gate.js",
    "iam:organization-write:window-gate": "tsx scripts/iam-organization-write-window-gate.ts",
    "iam:organization-write:window-gate:dist": "node dist/scripts/iam-organization-write-window-gate.js",
    "iam:organization-reconciliation:validate": "tsx scripts/iam-organization-reconciliation-validate.ts",
    "iam:organization-reconciliation:validate:dist": "node dist/scripts/iam-organization-reconciliation-validate.js",
    "invitation:import": "tsx scripts/invitation-import.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "bcryptjs": "^3.0.3",
    "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "body-parser": "^2.3.0",
    "form-data": "^4.0.6",
    "multer": "^2.2.0",
    "nanoid": "^3.3.17",
    "protobufjs": "^7.6.5"
  }
}
