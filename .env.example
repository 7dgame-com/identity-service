# Identity adapter
NODE_ENV=development
PORT=8086
IDENTITY_READONLY_MODE=true
JWKS_PUBLIC_KEYS_JSON={"keys":[]}
# Comma-separated browser origins. Keep production values explicit and do not
# use a wildcard because internal identity routes carry sensitive metadata.
IDENTITY_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3004,http://localhost:3005,http://localhost:3008

# Legacy platform database, read-only user recommended.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=bujiaban
LEGACY_DB_USER=bujiaban
LEGACY_DB_PASSWORD=testpassword

# Legacy platform database, write user for explicitly enabled native register
# only. Keep empty in normal read-only/proxy deployments.
LEGACY_WRITE_DB_HOST=
LEGACY_WRITE_DB_PORT=3306
LEGACY_WRITE_DB_NAME=bujiaban
LEGACY_WRITE_DB_USER=
LEGACY_WRITE_DB_PASSWORD=

# Dedicated future databases.
MYSQL_ROOT_PASSWORD=rootpassword
IDENTITY_DB_NAME=xrugc_identity
IDENTITY_DB_HOST=127.0.0.1
IDENTITY_DB_PORT=3306
KEYCLOAK_DB_NAME=xrugc_keycloak
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity_password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password

# Keycloak placeholder for phase 3 only.
KEYCLOAK_BASE_URL=http://localhost:8087
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Redis is reserved for later stages.
REDIS_URL=redis://localhost:6379/1

# Phase 3.5 login audit. Disabled by default; does not bill or block users.
IDENTITY_LOGIN_AUDIT_ENABLED=false
IDENTITY_INTERNAL_API_TOKEN=
IDENTITY_LOGIN_AUDIT_HASH_SALT=xrugc-login-audit-v1

# Work package 4 organization membership compatibility layer. Keep every
# switch at this default posture until a separately approved develop window.
IDENTITY_IAM_ORG_WRITE_MODE=disabled
IDENTITY_IAM_ORG_WRITE_ROUTE_INTEGRATION_ENABLED=false
IDENTITY_IAM_ORG_WRITE_DUAL_WRITE_EXECUTION_ENABLED=false
IDENTITY_IAM_ORG_WRITE_ROLLOUT_MODE=off
IDENTITY_IAM_ORG_WRITE_ROLLOUT_ALLOWLIST=
IDENTITY_IAM_ORG_WRITE_ROLLOUT_PERCENTAGE=0

# Optional phase 5 compensation. Disabled by default; when enabled, native
# password change/reset can ask the legacy backend to revoke Yii Redis refresh
# sessions after the password operation succeeds.
IDENTITY_LEGACY_SESSION_REVOKE_ENABLED=false
IDENTITY_LEGACY_SESSION_REVOKE_URL=
IDENTITY_LEGACY_SESSION_REVOKE_TOKEN=
IDENTITY_LEGACY_SESSION_REVOKE_TIMEOUT_MS=800

# Phase 4 token issuance. Disabled by default; enable only for gray rollout.
IDENTITY_TOKEN_ISSUANCE_ENABLED=false
IDENTITY_JWT_PRIVATE_KEY_PEM=
IDENTITY_JWT_PRIVATE_KEY_FILE=
IDENTITY_JWT_PUBLIC_KEY_PEM=
IDENTITY_JWT_PUBLIC_KEY_FILE=
IDENTITY_JWT_KEY_ID=identity-stage4
IDENTITY_JWT_ISSUER=identity-service
IDENTITY_JWT_AUDIENCE=xrugc-api
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=10800
IDENTITY_REFRESH_TOKEN_TTL_SECONDS=604800

# Phase 5 account lifecycle. Disabled by default; proxy mode is only a
# compatibility bridge before native register/password/email/invitation specs.
IDENTITY_ACCOUNT_LIFECYCLE_ENABLED=false
IDENTITY_ACCOUNT_LIFECYCLE_MODE=disabled
IDENTITY_ACCOUNT_LIFECYCLE_LEGACY_API_BASE_URL=
IDENTITY_ACCOUNT_LIFECYCLE_TIMEOUT_MS=1500
IDENTITY_ACCOUNT_REGISTER_ENABLED=false
IDENTITY_ACCOUNT_PASSWORD_ENABLED=false
IDENTITY_ACCOUNT_PASSWORD_CHANGE_NATIVE_ENABLED=false
IDENTITY_ACCOUNT_PASSWORD_RESET_NATIVE_ENABLED=false
IDENTITY_ACCOUNT_EMAIL_ENABLED=false
IDENTITY_ACCOUNT_EMAIL_VERIFY_NATIVE_ENABLED=false
IDENTITY_ACCOUNT_EMAIL_CHANGE_NATIVE_ENABLED=false
IDENTITY_ACCOUNT_INVITATION_ENABLED=false
IDENTITY_ACCOUNT_INVITATION_MANAGEMENT_NATIVE_ENABLED=false
IDENTITY_ACCOUNT_INVITATION_CHECK_NATIVE_ENABLED=false
IDENTITY_ACCOUNT_INVITATION_RECORDS_NATIVE_ENABLED=false
IDENTITY_ACCOUNT_INVITATION_DIAGNOSTICS_ENABLED=false
IDENTITY_INVITATION_REDIS_URL=
IDENTITY_INVITATION_REDIS_SCAN_COUNT=100
IDENTITY_INVITATION_REDIS_MAX_KEYS=5000

# Phase 5 native password reset / email verification delivery. Keep empty unless
# a native email-sending flow is intentionally enabled.
IDENTITY_EMAIL_WEBHOOK_URL=
IDENTITY_EMAIL_WEBHOOK_TOKEN=
IDENTITY_PASSWORD_RESET_CODE_HASH_SALT=xrugc-password-reset-v1
IDENTITY_PASSWORD_RESET_CODE_TTL_SECONDS=900
IDENTITY_PASSWORD_RESET_RATE_LIMIT_SECONDS=60
IDENTITY_PASSWORD_RESET_MAX_ATTEMPTS=5
IDENTITY_PASSWORD_RESET_LOCK_SECONDS=900
IDENTITY_EMAIL_CODE_HASH_SALT=xrugc-email-verify-v1
IDENTITY_EMAIL_CODE_TTL_SECONDS=900
IDENTITY_EMAIL_RATE_LIMIT_SECONDS=60
IDENTITY_EMAIL_MAX_ATTEMPTS=5
IDENTITY_EMAIL_LOCK_SECONDS=900
IDENTITY_EMAIL_CHANGE_TOKEN_TTL_SECONDS=600

# Optional OpenTelemetry export.
OTEL_SERVICE_NAME=identity-adapter
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
