# Identity adapter
NODE_ENV=development
PORT=8086
IDENTITY_READONLY_MODE=true
JWKS_PUBLIC_KEYS_JSON={"keys":[]}

# Legacy platform database, read-only user recommended.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=bujiaban
LEGACY_DB_USER=bujiaban
LEGACY_DB_PASSWORD=testpassword

# Dedicated future databases.
MYSQL_ROOT_PASSWORD=rootpassword
IDENTITY_DB_NAME=xrugc_identity
IDENTITY_DB_HOST=127.0.0.1
IDENTITY_DB_PORT=3306
KEYCLOAK_DB_NAME=xrugc_keycloak
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity_password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password

# Keycloak placeholder for phase 3 only.
KEYCLOAK_BASE_URL=http://localhost:8087
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Redis is reserved for later stages.
REDIS_URL=redis://localhost:6379/1

# Phase 3.5 login audit. Disabled by default; does not bill or block users.
IDENTITY_LOGIN_AUDIT_ENABLED=false
IDENTITY_INTERNAL_API_TOKEN=
IDENTITY_LOGIN_AUDIT_HASH_SALT=xrugc-login-audit-v1

# Phase 4 token issuance. Disabled by default; enable only for gray rollout.
IDENTITY_TOKEN_ISSUANCE_ENABLED=false
IDENTITY_JWT_PRIVATE_KEY_PEM=
IDENTITY_JWT_PRIVATE_KEY_FILE=
IDENTITY_JWT_PUBLIC_KEY_PEM=
IDENTITY_JWT_PUBLIC_KEY_FILE=
IDENTITY_JWT_KEY_ID=identity-stage4
IDENTITY_JWT_ISSUER=identity-service
IDENTITY_JWT_AUDIENCE=xrugc-api
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=10800
IDENTITY_REFRESH_TOKEN_TTL_SECONDS=604800

# Optional OpenTelemetry export.
OTEL_SERVICE_NAME=identity-adapter
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
