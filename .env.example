# Identity adapter
NODE_ENV=development
PORT=8086
IDENTITY_READONLY_MODE=true
JWKS_PUBLIC_KEYS_JSON={"keys":[]}

# Legacy platform database, read-only user recommended.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=bujiaban
LEGACY_DB_USER=bujiaban
LEGACY_DB_PASSWORD=testpassword

# Dedicated future databases.
MYSQL_ROOT_PASSWORD=rootpassword
IDENTITY_DB_NAME=xrugc_identity
KEYCLOAK_DB_NAME=xrugc_keycloak
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity_password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_password

# Keycloak placeholder for phase 3 only.
KEYCLOAK_BASE_URL=http://localhost:8087
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Redis is reserved for later stages.
REDIS_URL=redis://localhost:6379/1

